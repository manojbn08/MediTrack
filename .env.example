# ==========================================
# MediTrack Environment Configuration
# ==========================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meditrack
DB_USER=root
DB_PASS=root

# Security & JWT Token (Min 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXP_MIN=60

# Pharmacy Geofencing (Bangalore central hub default)
PHARMACY_LAT=12.9716
PHARMACY_LNG=77.5946
DELIVERY_RADIUS_KM=15.0
DELIVERY_BASE_FEE=40.0
DELIVERY_FREE_THRESHOLD=500.0

# Optional: External Payment Gateway (Razorpay test mode)
RZP_KEY=rzp_test_mockKey123
RZP_SECRET=rzp_mockSecret456
RZP_WEBHOOK_SECRET=rzp_mockWebhookSecret789

# Frontend API Endpoint (defaults to http://localhost:8080/api)
VITE_API_URL=http://localhost:8080/api

# Email / Mailpit Configuration
MEDITRACK_MAIL_ENABLED=true
MEDITRACK_MAIL_FROM=noreply@meditrack.com
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# RabbitMQ Message Broker & STOMP Relay Configuration (Optional - set true when RabbitMQ is running)
MEDITRACK_RABBITMQ_ENABLED=false
MEDITRACK_RABBITMQ_HOST=localhost
MEDITRACK_RABBITMQ_PORT=5672
MEDITRACK_RABBITMQ_STOMP_PORT=61613
